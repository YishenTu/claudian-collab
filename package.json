{
  "name": "claudian-collab",
  "version": "0.1.1",
  "private": true,
  "description": "Collaboration for Obsidian with LAN and Cloud projects, tickets, reviews, and a local agent API",
  "license": "MIT",
  "author": "Yishen Tu",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-jest.js",
    "test:unit": "node scripts/run-jest.js",
    "test:lan-compatibility": "node scripts/run-lan-compatibility.mjs",
    "test:cross-platform": "node scripts/run-cross-platform-collab-tests.js",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test:build": "node --test scripts/*.test.mjs",
    "lint": "eslint src tests --max-warnings=0"
  },
  "dependencies": {
    "@claudian-collab/protocol": "5.1.0",
    "@codemirror/commands": "6.10.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@lezer/markdown": "1.7.2",
    "bonjour-service": "1.4.4",
    "cross-spawn": "7.0.6",
    "node-forge": "1.4.0",
    "sql.js": "1.14.1",
    "tslib": "^2.8.1",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@types/cross-spawn": "6.0.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.5.2",
    "@types/node-forge": "1.3.14",
    "@types/sql.js": "1.4.11",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.2.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "^30.3.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^26.1.0",
    "obsidian": "1.13.0",
    "stylelint": "^17.14.1",
    "terser": "^5.50.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view"
  }
}
